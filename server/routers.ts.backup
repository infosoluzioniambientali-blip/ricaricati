    // ─── BACKUP COMPLETO ────────────────────────────────────────────────────
    esportaBackup: adminProcedure.query(async () => {
      const [installatori, ordini, pratiche, documenti] = await Promise.all([
        getAllInstallatori(),
        getAllOrdini(),
        getAllPratiche(),
